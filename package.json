{
  "name": "leavesflow-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @leavesflow/web run dev",
    "build:web": "npm --workspace @leavesflow/web run build",
